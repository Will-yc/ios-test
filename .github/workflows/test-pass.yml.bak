name: Test iOS Certificate

on: workflow_dispatch

jobs:
  test-certificate:
    runs-on: macos-latest
    steps:
      - name: Test certificate import
        env:
          IOS_P12_BASE64: ${{ secrets.IOS_P12_BASE64 }}
          IOS_P12_PASSWORD: ${{ secrets.IOS_P12_PASSWORD }}
        run: |
          echo "=== 证书导入测试 ==="
          
          # 1. 解码证书
          echo "$IOS_P12_BASE64" | openssl base64 -d -A > distribution.p12
          
          # 2. 提取为 PEM 格式
          openssl pkcs12 -in distribution.p12 \
            -passin pass:"$IOS_P12_PASSWORD" \
            -nodes \
            -out temp.pem
          
          # 3. 直接导入 PEM 文件（security 会自动处理）
          security import temp.pem \
            -k ~/Library/Keychains/login.keychain-db \
            -T /usr/bin/codesign \
            -T /usr/bin/productsign
          
          # 4. 查看结果
          echo "可用签名证书:"
          security find-identity -v -p codesigning
          
          echo "=== 完成 ==="